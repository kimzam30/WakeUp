{
  "name": "wakeup",
  "version": "2.5.0",
  "description": "Ebwise, Outlook, Teams, your timetable and tasks in one calm window",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "python3 scripts/make-icons.py",
    "dist": "python3 scripts/make-icons.py && electron-builder --linux dir",
    "dist:appimage": "python3 scripts/make-icons.py && electron-builder --linux AppImage",
    "install-app": "bash scripts/install.sh",
    "test": "node --test test/*.test.js"
  },
  "author": "kimzam",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "productName": "WakeUp",
  "private": true,
  "build": {
    "appId": "my.kimzam.wakeup",
    "productName": "WakeUp",
    "executableName": "wakeup",
    "files": [
      "src/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icons",
      "category": "Office",
      "desktop": {
        "entry": {
          "Name": "WakeUp",
          "Comment": "Ebwise, Outlook, Teams, your timetable and tasks in one window",
          "StartupWMClass": "wakeup",
          "Keywords": "mail;teams;outlook;calendar;todo;ebwise;mmu;timetable;tasks;"
        }
      }
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "appImage": {
      "artifactName": "WakeUp-${version}.AppImage"
    }
  },
  "desktopName": "wakeup.desktop",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
